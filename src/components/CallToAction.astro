---
import { site } from '../data/site';
---

<div class="actions">
	<a class="btn" href={site.calendly} target="_blank" rel="noreferrer">Book a free 15-min call</a>
	<a class="link" href={`mailto:${site.email}`}>{site.email}</a>
</div>

<style>
	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.25rem 1.75rem;
		margin-top: 2.25rem;
	}
	.btn {
		display: inline-block;
		padding: 0.8rem 1.3rem;
		background: var(--ink);
		color: var(--bg);
		text-decoration: none;
		font-weight: 500;
		border-radius: 2px;
		transition:
			background-color 0.2s ease,
			transform 0.2s ease;
	}
	.btn:hover {
		background: var(--accent);
		transform: translateY(-1px);
	}
</style>
