---
// A page section: a small mono label in the left column, content on the right.
// Use labelAs="h2" when the section has no h2 of its own, so it still shows in the page outline.
interface Props {
	label: string;
	id?: string;
	labelAs?: 'p' | 'h2';
}

const { label, id, labelAs: Label = 'p' } = Astro.props;
---

<section id={id} class="wrap section" data-reveal>
	<Label class="label">{label}</Label>
	<div><slot /></div>
</section>

<style>
	.section {
		position: relative;
		isolation: isolate; /* lets a Krackle texture sit behind the content */
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
		padding-top: 2rem;
		padding-bottom: clamp(4rem, 10vh, 6rem);
		border-top: 1px solid var(--line);
	}
	@media (min-width: 48rem) {
		.section {
			grid-template-columns: 14rem 1fr;
			gap: 2rem;
		}
	}
	/* An h2 label keeps the small label look, not the heading styles. */
	h2.label {
		font-weight: 400;
		line-height: inherit;
		font-variation-settings: normal;
	}
	.section :global(h2:not(.label)) {
		font-size: clamp(2rem, 4.5vw, 3rem);
		max-width: 22ch;
	}
</style>
