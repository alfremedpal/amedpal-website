---
import Section from '../Section.astro';
import { useTranslations } from '../../i18n/ui';

const t = useTranslations(Astro.currentLocale);
---

<Section label={t.ai.label}>
	<h2>{t.ai.title}</h2>
	<p class="body">{t.ai.body}</p>
	<ul class="pains" role="list">
		{t.ai.pains.map((p) => <li>“{p}”</li>)}
	</ul>
</Section>

<style>
	.pains {
		list-style: none;
		padding: 0;
		margin: 2rem 0 0;
		display: grid;
		gap: 0.75rem;
	}
	li {
		padding-left: 1rem;
		border-left: 2px solid var(--accent);
		font-family: var(--serif);
		font-style: italic;
		font-size: 1.375rem;
		line-height: 1.35;
	}
</style>
